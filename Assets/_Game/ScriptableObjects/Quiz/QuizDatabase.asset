%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 29c33c7b0a050004b8f8ab8ad9acae79, type: 3}
  m_Name: QuizDatabase
  m_EditorClassIdentifier: Assembly-CSharp::GamifyKWU.CraneGame.Data.QuizDatabaseSO
  m_quizList:
  - m_question: "(?) 정보를 시각적으로 압축하여 전달하는 UI 요소이다.\n\n텍스트보다 빠르게 의미를 전달\n메뉴, 기능, 상태 표시 등에 활용\n스마트폰 앱에서 자주 사용"
    m_correctAnswer: "아이콘"
    m_wrongAnswers:
    - "폰트"
    - "팝업"
    - "체크박스"
    m_quizType: 0
    m_explanation: "정보를 시각적으로 압축하여 전달하는 UI 요소입니다."
    m_category: 0
    m_hint: "그림으로 핵심을 보여주는 것!"
  - m_question: "(?)은 화면 위에 나타나 사용자의 주의를 끌고, 중요한 정보를 전달하는 UI 요소이다.\n\n사용자의 시선을 집중 시킴\n알림, 경고, 확인 요청, 안내 등에 활용\n사용자의 선택(확인, 취소 등)을 받아<br>다음 행동을 유도"
    m_correctAnswer: "팝업"
    m_wrongAnswers:
    - "아이콘"
    - "드롭박스"
    - "체크박스"
    m_quizType: 0
    m_explanation: "화면 위에 나타나 사용자의 주의를 끌고 정보를 전달하는 UI 요소입니다."
    m_category: 0
    m_hint: "갑자기 나타나는 창!"
  - m_question: "(?)은 여러 옵션 중 하나를 선택할 수 있게 해주는 UI 요소이다.\n\n클릭하여 목록을 열고 옵션을 확인\n여러 항목 중 하나를 선택하는 데 활용\n선택한 내용을 현재 화면에 간결하게 표시"
    m_correctAnswer: "드롭박스"
    m_wrongAnswers:
    - "아이콘"
    - "팝업"
    - "체크박스"
    m_quizType: 0
    m_explanation: "여러 옵션 중 하나를 선택할 수 있게 해주는 UI 요소입니다."
    m_category: 0
    m_hint: "목록에서 하나를 골라 선택하는 것!"
  - m_question: "(?)은 항목을 선택하거나 해제할 수 있게 해주는 UI 요소이다.\n\n클릭하여 선택 상태를 변경\n여러 항목을 동시에 선택하거나 해제하는<br>데 활용\n선택 여부를 시각적으로 보여줌"
    m_correctAnswer: "체크박스"
    m_wrongAnswers:
    - "아이콘"
    - "드롭박스"
    - "팝업"
    m_quizType: 0
    m_explanation: "항목을 선택하거나 해제할 수 있게 해주는 UI 요소입니다."
    m_category: 0
    m_hint: "작은 상자를 클릭해 선택을 표시하는 것!"
  - m_question: "(?)은 글자의 모양, 크기, 두께 등을 설정할 수 있게 해주는 UI 요소이다.\n\n클릭하여 글자 스타일을 변경\n여러 스타일 중 하나를 선택하여 적용하는<br>데 활용\n가독성과 분위기를 조절"
    m_correctAnswer: "폰트"
    m_wrongAnswers:
    - "아이콘"
    - "팝업"
    - "체크박스"
    m_quizType: 0
    m_explanation: "글자의 모양, 크기, 두께 등을 설정할 수 있게 해주는 UI 요소입니다."
    m_category: 0
    m_hint: "글자의 스타일을 바꿔 적용하는 것!"
  - m_question: "(?) 정보를 시각적으로 압축하여 전달하는 UI 요소이다.\n\n텍스트보다 빠르게 의미를 전달\n메뉴, 기능, 상태 표시 등에 활용\n스마트폰 앱에서 자주 사용"
    m_correctAnswer: "아이콘"
    m_wrongAnswers:
    - "폰트"
    - "팝업"
    - "체크박스"
    m_quizType: 1
    m_explanation: "정보를 시각적으로 압축하여 전달하는 UI 요소입니다."
    m_category: 0
    m_hint: "그림으로 핵심을 보여주는 것!"
  - m_question: "(?)은 화면 위에 나타나 사용자의 주의를 끌고, 중요한 정보를 전달하는 UI 요소이다.\n\n사용자의 시선을 집중 시킴\n알림, 경고, 확인 요청, 안내 등에 활용\n사용자의 선택(확인, 취소 등)을 받아<br>다음 행동을 유도"
