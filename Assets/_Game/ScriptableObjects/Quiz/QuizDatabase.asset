  m_quizList:
  - m_question: "(?) \uC815\uBCF4\uB97C \uC2DC\uAC01\uC801\uC73C\uB85C \uC555\uCD95\uD558\uC5EC
      \uC804\uB2EC\uD558\uB294 UI \uC694\uC18C\uC774\uB2E4.\n\n\uD14D\uC2A4\uD2B8\uBCF4\uB2E4
      \uBE60\uB974\uAC8C \uC758\uBBF8\uB97C \uC804\uB2EC\n\uBA54\uB274, \uAE30\uB2A5,
      \uC0C1\uD0DC \uD45C\uC2DC \uB4F1\uC5D0 \uD65C\uC6A9\n\uC2A4\uB9C8\uD2B8\uD3F0
      \uC571\uC5D0\uC11C \uC790\uC8FC \uC0AC\uC6A9"
    m_correctAnswer: "\uC544\uC774\uCF58"
    m_wrongAnswers:
    - "\uD3F0\uD2B8"
    - "\uD31D\uC5C5"
    - "\uCCB4\uD06C\uBC15\uC2A4"
    m_quizType: 0
    m_explanation: "\uC815\uBCF4\uB97C \uC2DC\uAC01\uC801\uC73C\uB85C \uC555\uCD95\uD558\uC5EC
      \uC804\uB2EC\uD558\uB294 UI \uC694\uC18C\uC785\uB2C8\uB2E4."
    m_category: 0
    m_hint: "\uADF8\uB9BC\uC73C\uB85C \uD575\uC2EC\uC744 \uBCF4\uC5EC\uC8FC\uB294
      \uAC83!"
  - m_question: "(?)\uC740 \uD654\uBA74 \uC704\uC5D0 \uB098\uD0C0\uB098 \uC0AC\uC6A9\uC790\uC758
      \uC8FC\uC758\uB97C \uB04C\uACE0, \uC911\uC694\uD55C \uC815\uBCF4\uB97C \uC804\uB2EC\uD558\uB294
      UI \uC694\uC18C\uC774\uB2E4.\n\n\uC0AC\uC6A9\uC790\uC758 \uC2DC\uC120\uC744
      \uC9D1\uC911 \uC2DC\uD0B4\n\uC54C\uB9BC, \uACBD\uACE0, \uD655\uC778 \uC694\uCCAD,
      \uC548\uB0B4 \uB4F1\uC5D0 \uD65C\uC6A9\n\uC0AC\uC6A9\uC790\uC758 \uC120\uD0DD(\uD655\uC778,
      \uCDE8\uC18C \uB4F1)\uC744 \uBC1B\uC544<br>\uB2E4\uC74C \uD589\uB3D9\uC744
      \uC720\uB3C4"
    m_correctAnswer: "\uD31D\uC5C5"
    m_wrongAnswers:
    - "\uC544\uC774\uCF58"
    - "\uB4DC\uB86D\uBC15\uC2A4"
    - "\uCCB4\uD06C\uBC15\uC2A4"
    m_quizType: 0
    m_explanation: "\uD654\uBA74 \uC704\uC5D0 \uB098\uD0C0\uB098 \uC0AC\uC6A9\uC790\uC758
      \uC8FC\uC758\uB97C \uB04C\uACE0 \uC815\uBCF4\uB97C \uC804\uB2EC\uD558\uB294
      UI \uC694\uC18C\uC785\uB2C8\uB2E4."
    m_category: 0
    m_hint: "\uAC11\uC790\uAE30 \uB098\uD0C0\uB098\uB294 \uCC3D!"
  - m_question: "(?)\uC740 \uC5EC\uB7EC \uC635\uC158 \uC911 \uD558\uB098\uB97C \uC120\uD0DD\uD560
      \uC218 \uC788\uAC8C \uD574\uC8FC\uB294 UI \uC694\uC18C\uC774\uB2E4.\n\n\uD074\uB9AD\uD558\uC5EC
      \uBAA9\uB85D\uC744 \uC5F4\uACE0 \uC635\uC158\uC744 \uD655\uC778\n\uC5EC\uB7EC
      \uD56D\uBAA9 \uC911 \uD558\uB098\uB97C \uC120\uD0DD\uD558\uB294 \uB370 \uD65C\uC6A9\n\uC120\uD0DD\uD55C
      \uB0B4\uC6A9\uC744 \uD604\uC7AC \uD654\uBA74\uC5D0 \uAC04\uACB0\uD558\uAC8C
      \uD45C\uC2DC"
    m_correctAnswer: "\uB4DC\uB86D\uBC15\uC2A4"
    m_wrongAnswers:
    - "\uC544\uC774\uCF58"
    - "\uD31D\uC5C5"
    - "\uCCB4\uD06C\uBC15\uC2A4"
    m_quizType: 0
    m_explanation: "\uC5EC\uB7EC \uC635\uC158 \uC911 \uD558\uB098\uB97C \uC120\uD0DD\uD560
      \uC218 \uC788\uAC8C \uD574\uC8FC\uB294 UI \uC694\uC18C\uC785\uB2C8\uB2E4."
    m_category: 0
    m_hint: "\uBAA9\uB85D\uC5D0\uC11C \uD558\uB098\uB97C \uACE8\uB77C \uC120\uD0DD\uD558\uB294
      \uAC83!"
  - m_question: "(?)\uC740 \uD56D\uBAA9\uC744 \uC120\uD0DD\uD558\uAC70\uB098 \uD574\uC81C\uD560
      \uC218 \uC788\uAC8C \uD574\uC8FC\uB294 UI \uC694\uC18C\uC774\uB2E4.\n\n\uD074\uB9AD\uD558\uC5EC
      \uC120\uD0DD \uC0C1\uD0DC\uB97C \uBCC0\uACBD\n\uC5EC\uB7EC \uD56D\uBAA9\uC744
      \uB3D9\uC2DC\uC5D0 \uC120\uD0DD\uD558\uAC70\uB098 \uD574\uC81C\uD558\uB294<br>\uB370
