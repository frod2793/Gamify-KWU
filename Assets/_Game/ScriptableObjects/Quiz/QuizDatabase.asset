    m_correctAnswer: "\uCCB4\uD06C\uBC15\uC2A4"
    m_wrongAnswers:
    - "\uC544\uC774\uCF58"
    - "\uB4DC\uB86D\uBC15\uC2A4"
    - "\uD31D\uC5C5"
    m_quizType: 0
    m_explanation: "\uD56D\uBAA9\uC744 \uC120\uD0DD\uD558\uAC70\uB098 \uD574\uC81C\uD560
      \uC218 \uC788\uAC8C \uD574\uC8FC\uB294 UI \uC694\uC18C\uC785\uB2C8\uB2E4."
    m_category: 0
    m_hint: "\uC791\uC740 \uC0C1\uC790\uB97C \uD074\uB9AD\uD574 \uC120\uD0DD\uC744
      \uD45C\uC2DC\uD558\uB294 \uAC83!"
  - m_question: "(?)\uC740 \uAE00\uC790\uC758 \uBAA8\uC591, \uD06C\uAE30, \uB450\uAED8
